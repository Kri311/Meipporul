POSTGRES_USER=veritas_admin
POSTGRES_PASSWORD=veritas_secret_password
POSTGRES_DB=veritas_lens
SUMMARY_MODEL_NAME=auto
SUMMARY_BASE_MODEL=csebuetnlp/mT5_multilingual_XLSum
SUMMARY_FINETUNED_MODEL_PATH=src/backend/models/summarizer/best
SUMMARY_PREFER_FINETUNED=1
# Prefer CUDA for the summarizer; it falls back to CPU if CUDA is unavailable.
SUMMARY_DEVICE=cuda
EMBEDDING_DEVICE=cuda
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
# DBSCAN radius in cosine distance; clusters need at least 0.88 pairwise cosine similarity.
DBSCAN_EPS=0.12
DBSCAN_MIN_SAMPLES=2
CLUSTER_MIN_PAIRWISE_SIMILARITY=0.88
CLUSTER_ENTITYLESS_MIN_SIMILARITY=0.92
CLUSTER_ORG_ONLY_MIN_SIMILARITY=0.90
CLUSTER_PERSON_ONLY_MIN_SIMILARITY=0.90
CLUSTER_MAX_GAP_DAYS=5
BREAKING_NEWS_WINDOW_HOURS=24
TOPIC_DEVICE=auto
# Load the selected supervised E5 model, with multilingual zero-shot fallback.
TOPIC_CLASSIFIER_BACKEND=auto
TOPIC_ZERO_SHOT_MODEL=MoritzLaurer/multilingual-MiniLMv2-L6-mnli-xnli
TOPIC_ZERO_SHOT_MIN_SCORE=0.45
TOPIC_ZERO_SHOT_MIN_MARGIN=0.05
# Minimum support for choosing the best non-Other class when the supervised
# classifier would otherwise abstain to Other.
TOPIC_NON_OTHER_MIN_SCORE=0.30
# Recover an existing taxonomy topic on a low-confidence classifier result
# only when headline keywords provide this much evidence (one title match = 5).
TOPIC_RULE_OVERRIDE_MIN_SCORE=5
# Local fine-tuned MuRIL NER is the default when its checkpoint exists.
NER_PREFER_FINETUNED_MODEL=1
# Set to 1 only to allow Babelscape fallback if the fine-tuned NER cannot load.
NER_ALLOW_TEACHER_FALLBACK=1
